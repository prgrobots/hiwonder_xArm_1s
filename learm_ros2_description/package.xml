<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>learm_ros2_description</name>
  <version>1.1.0</version>
  <description>
    URDF description, meshes and ros2_control configuration for the
    Hiwonder LeArm / xArm 1S simulation.
  </description>

  <author>Andrew Dassonville</author>
  <maintainer email="dassonville.andrew@gmail.com">Andrew Dassonville</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>liburdfdom-tools</test_depend>
  <test_depend>xacro</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
