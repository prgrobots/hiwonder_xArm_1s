<?xml version="1.0"?>
<!--
  Hiwonder LeArm / xArm 1S description.

  This is the single source of truth for the simulated robot. The
  <ros2_control> block uses ros2_control's mock hardware, so no physical
  arm or Gazebo is required.
-->
<robot name="learm" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="link_inertia" params="mass">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia ixx="${mass * 0.001}" ixy="0" ixz="0"
               iyy="${mass * 0.001}" iyz="0"
               izz="${mass * 0.001}"/>
    </inertial>
  </xacro:macro>

  <!-- ==================== Links ==================== -->

  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="package://learm_ros2_description/meshes/base.stl"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://learm_ros2_description/meshes/base.stl"/>
      </geometry>
    </collision>
    <xacro:link_inertia mass="0.25"/>
  </link>

  <link name="shoulder_link">
    <visual>
      <geometry>
        <mesh filename="package://learm_ros2_description/meshes/shoulder.stl"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://learm_ros2_description/meshes/shoulder.stl"/>
      </geometry>
    </collision>
    <xacro:link_inertia mass="0.12"/>
  </link>

  <link name="humerus_link">
    <visual>
      <geometry>
        <mesh filename="package://learm_ros2_description/meshes/humerus.stl"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://learm_ros2_description/meshes/humerus.stl"/>
      </geometry>
    </collision>
    <xacro:link_inertia mass="0.14"/>
  </link>

  <link name="forearm_link">
    <visual>
      <geometry>
        <mesh filename="package://learm_ros2_description/meshes/forearm.stl"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://learm_ros2_description/meshes/forearm.stl"/>
      </geometry>
    </collision>
    <xacro:link_inertia mass="0.10"/>
  </link>

  <link name="wrist_link">
    <visual>
      <geometry>
        <mesh filename="package://learm_ros2_description/meshes/wrist.stl"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://learm_ros2_description/meshes/wrist.stl"/>
      </geometry>
    </collision>
    <xacro:link_inertia mass="0.06"/>
  </link>

  <link name="hand_link">
    <visual>
      <geometry>
        <mesh filename="package://learm_ros2_description/meshes/hand.stl"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://learm_ros2_description/meshes/hand.stl"/>
      </geometry>
    </collision>
    <xacro:link_inertia mass="0.05"/>
  </link>

  <link name="grip_left_link">
    <visual>
      <geometry>
        <mesh filename="package://learm_ros2_description/meshes/carpal-left.stl"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://learm_ros2_description/meshes/carpal-left.stl"/>
      </geometry>
    </collision>
    <xacro:link_inertia mass="0.02"/>
  </link>

  <link name="grip_right_link">
    <visual>
      <geometry>
        <mesh filename="package://learm_ros2_description/meshes/carpal-right.stl"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://learm_ros2_description/meshes/carpal-right.stl"/>
      </geometry>
    </collision>
    <xacro:link_inertia mass="0.02"/>
  </link>

  <link name="tendon_left_link">
    <visual>
      <geometry>
        <mesh filename="package://learm_ros2_description/meshes/tendon.stl"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://learm_ros2_description/meshes/tendon.stl"/>
      </geometry>
    </collision>
    <xacro:link_inertia mass="0.01"/>
  </link>

  <link name="tendon_right_link">
    <visual>
      <geometry>
        <mesh filename="package://learm_ros2_description/meshes/tendon.stl"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://learm_ros2_description/meshes/tendon.stl"/>
      </geometry>
    </collision>
    <xacro:link_inertia mass="0.01"/>
  </link>

  <link name="finger_left_link">
    <visual>
      <geometry>
        <mesh filename="package://learm_ros2_description/meshes/finger.stl"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://learm_ros2_description/meshes/finger.stl"/>
      </geometry>
    </collision>
    <xacro:link_inertia mass="0.01"/>
  </link>

  <link name="finger_right_link">
    <visual>
      <origin rpy="0 0 3.14159" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://learm_ros2_description/meshes/finger.stl"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 3.14159" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://learm_ros2_description/meshes/finger.stl"/>
      </geometry>
    </collision>
    <xacro:link_inertia mass="0.01"/>
  </link>

  <!-- ==================== Joints ==================== -->

  <joint name="shoulder_pan" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.059" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="1000" velocity="0.5"/>
  </joint>

  <joint name="shoulder_lift" type="revolute">
    <parent link="shoulder_link"/>
    <child link="humerus_link"/>
    <origin xyz="-0.010 0 0.028" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="1000" velocity="0.5"/>
  </joint>

  <joint name="elbow" type="revolute">
    <parent link="humerus_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 0 0.105" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-1.57" upper="1.57" effort="1000" velocity="0.5"/>
  </joint>

  <joint name="wrist_flex" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_link"/>
    <origin xyz="0 0 0.090" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <!-- The old URDF had these limits reversed (lower=1.57, upper=-1.57). -->
    <limit lower="-1.57" upper="1.57" effort="1000" velocity="0.5"/>
  </joint>

  <joint name="wrist_roll" type="revolute">
    <parent link="wrist_link"/>
    <child link="hand_link"/>
    <origin xyz="0 0 0.060" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="1000" velocity="0.5"/>
  </joint>

  <joint name="grip_left" type="revolute">
    <parent link="hand_link"/>
    <child link="grip_left_link"/>
    <origin xyz="0 +0.015 0.030" rpy="-1.57 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-1.57" upper="0" effort="1000" velocity="0.5"/>
  </joint>

  <joint name="grip_right" type="revolute">
    <parent link="hand_link"/>
    <child link="grip_right_link"/>
    <origin xyz="0 -0.015 0.030" rpy="1.57 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0" upper="1.57" effort="1000" velocity="0.5"/>
    <mimic joint="grip_left" multiplier="-1"/>
  </joint>

  <joint name="tendon_left" type="revolute">
    <parent link="hand_link"/>
    <child link="tendon_left_link"/>
    <origin xyz="0 +0.005 0.050" rpy="-1.57 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-1.57" upper="0" effort="1000" velocity="0.5"/>
    <mimic joint="grip_left"/>
  </joint>

  <joint name="tendon_right" type="revolute">
    <parent link="hand_link"/>
    <child link="tendon_right_link"/>
    <origin xyz="0 -0.005 0.050" rpy="1.57 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0" upper="1.57" effort="1000" velocity="0.5"/>
    <mimic joint="grip_left" multiplier="-1"/>
  </joint>

  <joint name="finger_left" type="revolute">
    <parent link="grip_left_link"/>
    <child link="finger_left_link"/>
    <origin xyz="0 0 0.030" rpy="1.57 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-1.57" upper="0" effort="1000" velocity="0.5"/>
    <mimic joint="grip_left" multiplier="-1"/>
  </joint>

  <joint name="finger_right" type="revolute">
    <parent link="grip_right_link"/>
    <child link="finger_right_link"/>
    <origin xyz="0 0 0.030" rpy="-1.57 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0" upper="1.57" effort="1000" velocity="0.5"/>
    <mimic joint="grip_left"/>
  </joint>

  <!--
    Mock hardware: exposes position command interfaces and position/velocity
    state interfaces for the six actuated joints, so the arm can be driven
    without any physical device or Gazebo.
  -->
  <ros2_control name="LeArmSystem" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
      <param name="calculate_dynamics">true</param>
    </hardware>

    <joint name="shoulder_pan">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="shoulder_lift">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="elbow">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wrist_flex">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wrist_roll">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="grip_left">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

</robot>
